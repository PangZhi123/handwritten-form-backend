# Algorithm API process - 4B TEST config (测试部署用)
# 与 .env.test-server.example(30B正式) 的区别：
#   HF_MODEL_BASE_URL 指向 4B llama-server 端口(默认8081)
#   HF_MODEL_NAME 为 4B 模型别名 qwen3-vl-4b-instruct
# 启动顺序：先运行 scripts\start-qwen-vl-4b-test.ps1，再启动本后端。
HF_RUNTIME_ROOT=D:/handwritten-form-runtime-4b
HF_OCR_BACKEND=qwen_vl
HF_MODEL_BASE_URL=http://127.0.0.1:8081/v1
HF_MODEL_NAME=qwen3-vl-4b-instruct
HF_MODEL_API_KEY=local
HF_MODEL_TIMEOUT_SECONDS=600
HF_MODEL_RETRIES=2
HF_MODEL_MAX_TOKENS=8192
HF_MODEL_MAX_CONCURRENCY=1
HF_LOW_CONFIDENCE_THRESHOLD=0.70
HF_MAX_SOURCE_FILES=20
HF_MAX_FILE_SIZE_MB=30

# Address seen by frontend testers; do not use 127.0.0.1 here.
HF_PUBLIC_BASE_URL=http://测试服务器IP:8000

# Exact frontend test origins, comma-separated.
HF_CORS_ORIGINS=http://前端测试地址:端口,http://localhost:5173
